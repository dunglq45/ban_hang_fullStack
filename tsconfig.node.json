{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/node.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  // scripts/seed.ts dùng service của Worker qua .d.ts của project worker (không nạp runtime types).
  "references": [{ "path": "./tsconfig.worker.json" }],
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "scripts"
  ]
}
